# Marketplace backend configuration.
# Copy to ".env.local" for local dev, or set these in Vercel's project
# Environment Variables. Without them the app uses built-in sample data.

# Mapbox public token used by the live network map.
# Vite exposes VITE_ variables at build time, so redeploy after changing this.
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Supabase browser client. These are public client values, not service-role secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional while the full account/operator switcher is being wired.
# Set this to a verified operator UUID from the operators table so claim actions
# can sync to Supabase from the browser.
# VITE_OPERATOR_ID=

# Your backend endpoint that returns airport regions + journeys as JSON.
# Supabase is now the preferred data source; keep this only as a legacy fallback.
# VITE_MARKETPLACE_API_URL=https://your-backend.example.com/api/regions

# Optional. If set, sent as "Authorization: Bearer <key>".
# NOTE: Vite env vars are bundled into the public client build, so only
# put a token here if it is safe to expose (e.g. a public read-only key).
# For secrets, make the endpoint public-read or proxy it server-side.
# VITE_MARKETPLACE_API_KEY=

# Join / operator sign-up endpoint. Defaults to the built-in Vercel
# serverless function at /api/signup (see api/signup.ts) — only set this
# to override with an external endpoint. POST JSON body:
#   { "name": "...", "email": "...", "fleet": "...", "source": "wasted-miles-web" }
# VITE_SIGNUP_API_URL=
# VITE_SIGNUP_API_KEY=

# --- Data / auth layer ---
# Base URL of your backend API. When set, the app syncs claims, messages
# and other resources to it (see src/lib/api.ts). When unset, the app
# runs on local mock + localStorage-persisted data.
#
# The Relay screens read through this same client (src/relay/data.ts).
# When VITE_API_URL is set they call, relative to the base URL:
#   GET  /relay/network   -> { airports, routes, totalJobs, available, opportunities }
#   GET  /relay/bid       -> { from, to, buyNow, highestBid, timeline[] }
#   GET  /relay/threads   -> [{ id, name, preview }]
#   GET  /relay/profile   -> { fleetName, email, phone }
#   POST /relay/cover     -> { date, pickup, dropoff, tier, offer }
#   POST /relay/profile   -> { fleetName, email, phone }
# When unset, each falls back to seed data persisted in localStorage.
# VITE_API_URL=https://api.your-backend.example
# Auth endpoint (sign-in). Defaults to the Vercel serverless /api/auth
# demo stub; replace with a real identity provider.
# VITE_AUTH_API_URL=

# Marketplace actions (claim / message / operator actions). Defaults to
# the built-in Vercel serverless function at /api/action (see
# api/action.ts) — only set to override with an external endpoint.
# VITE_ACTIONS_API_URL=
# VITE_ACTIONS_API_KEY=

# --- Server-side (NOT exposed to the client; set in Vercel) ---
# Optional webhook the /api/signup function forwards each signup to
# (e.g. a Slack incoming webhook, Zapier catch hook, or email service).
# SIGNUP_WEBHOOK_URL=
# Optional webhook the /api/action function forwards each action to.
# ACTIONS_WEBHOOK_URL=
