# Marketplace backend configuration.
# Copy to ".env.local" for local dev, or set these in Vercel's project
# Environment Variables. Without them the app uses built-in sample data.

# Your backend endpoint that returns airport regions + journeys as JSON
# (an array of Region objects, or { "regions": [...] } / { "data": [...] }).
VITE_MARKETPLACE_API_URL=https://your-backend.example.com/api/regions

# Optional. If set, sent as "Authorization: Bearer <key>".
# NOTE: Vite env vars are bundled into the public client build, so only
# put a token here if it is safe to expose (e.g. a public read-only key).
# For secrets, make the endpoint public-read or proxy it server-side.
# VITE_MARKETPLACE_API_KEY=

# Join / operator sign-up endpoint. Receives a POST with JSON body:
#   { "name": "...", "email": "...", "fleet": "...", "source": "wasted-miles-web" }
# Without it, the Join form succeeds locally (no network call).
VITE_SIGNUP_API_URL=https://your-backend.example.com/api/signup

# Optional bearer token for the sign-up endpoint (see note above).
# VITE_SIGNUP_API_KEY=
