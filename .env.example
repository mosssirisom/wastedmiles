# Marketplace backend configuration.
# Copy to ".env.local" for local dev, or set these in Vercel's project
# Environment Variables. Without them the app uses built-in sample data.

# Your backend endpoint that returns airport regions + journeys as JSON
# (an array of Region objects, or { "regions": [...] } / { "data": [...] }).
VITE_MARKETPLACE_API_URL=https://your-backend.example.com/api/regions

# Optional. If set, sent as "Authorization: Bearer <key>".
# NOTE: Vite env vars are bundled into the public client build, so only
# put a token here if it is safe to expose (e.g. a public read-only key).
# For secrets, make the endpoint public-read or proxy it server-side.
# VITE_MARKETPLACE_API_KEY=

# Join / operator sign-up endpoint. Defaults to the built-in Vercel
# serverless function at /api/signup (see api/signup.ts) — only set this
# to override with an external endpoint. POST JSON body:
#   { "name": "...", "email": "...", "fleet": "...", "source": "wasted-miles-web" }
# VITE_SIGNUP_API_URL=
# VITE_SIGNUP_API_KEY=

# Marketplace actions (claim / message / operator actions). Defaults to
# the built-in Vercel serverless function at /api/action (see
# api/action.ts) — only set to override with an external endpoint.
# VITE_ACTIONS_API_URL=
# VITE_ACTIONS_API_KEY=

# --- Server-side (NOT exposed to the client; set in Vercel) ---
# Optional webhook the /api/signup function forwards each signup to
# (e.g. a Slack incoming webhook, Zapier catch hook, or email service).
# SIGNUP_WEBHOOK_URL=
# Optional webhook the /api/action function forwards each action to.
# ACTIONS_WEBHOOK_URL=
